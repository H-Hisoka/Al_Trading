def test_feature_builder_does_not_modify_input(
    market_data,
):
    original = market_data.copy(deep=True)

    calculate_features(market_data)

    pd.testing.assert_frame_equal(
        market_data,
        original,
    )


def test_feature_builder_rejects_unsorted_data(
    market_data,
):
    unsorted = market_data.iloc[::-1].copy()

    with pytest.raises(
        (ValueError, AssertionError)
    ):
        calculate_features(unsorted)


def test_feature_builder_rejects_duplicate_timestamps(
    market_data,
):
    duplicated = pd.concat(
        [
            market_data,
            market_data.iloc[[10]],
        ]
    ).sort_index()

    with pytest.raises(
        (ValueError, AssertionError)
    ):
        calculate_features(duplicated)


def test_feature_builder_rejects_missing_ohlc(
    market_data,
):
    invalid = market_data.drop(
        columns=["Close"]
    )

    with pytest.raises(
        (ValueError, KeyError)
    ):
        calculate_features(invalid)


# ============================================================
# FUTURE DATA IS ALLOWED ONLY IN LABELS
# ============================================================

def test_future_label_columns_are_not_features(
    market_data,
):
    """
    Future labels được phép sử dụng dữ liệu tương lai
    để tạo target.

    Nhưng những cột đó không được xuất hiện trong X.
    """
    data = add_future_labels(market_data)

    features = calculate_features(data)

    forbidden = [
        col
        for col in features.columns
        if str(col).lower().startswith("future_")
        or str(col).lower() in (
            "target",
            "label",
            "event_label",
        )
    ]

    assert forbidden == []


def test_feature_builder_is_deterministic(
    market_data,
):
    """
    Cùng dữ liệu đầu vào phải tạo cùng feature.
    """
    first = calculate_features(market_data)
    second = calculate_features(market_data)

    pd.testing.assert_frame_equal(
        first,
        second,
        check_dtype=False,
    )
